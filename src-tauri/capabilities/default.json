{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "EnvDeck main window. Keep minimal: file I/O, pickers, reveal and drag-out go through EnvDeck's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "vscode://file/*" },
        { "url": "vscode-insiders://file/*" },
        { "url": "cursor://file/*" },
        { "url": "windsurf://file/*" }
      ]
    }
  ]
}
